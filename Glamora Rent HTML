    <!-- BAGIAN 3: KATALOG (PM 2) -->
    <section id="catalog-section" data-role="PM">
      <h2>Katalog paket</h2>
      <p class="sub">Harga dihitung per hari sewa.</p>


      <div class="paket-grid">
        <article class="paket">
          <h3>Paket Busana Dasar</h3>
          <p class="harga">Rp150.000<span> / hari</span></p>
          <p>Sewa 1 busana pilihan: toga wisuda, jas resmi, atau kebaya.</p>
          <p class="promo">Kode promo: GLAMORA (diskon 15%)</p>
        </article>
        <article class="paket unggulan">
          <h3>Paket Busana Beserta Rias Wajah</h3>
          <p class="harga">Rp300.000<span> / hari</span></p>
          <p>Sewa 1 busana lengkap dengan rias wajah profesional.</p>
          <p class="promo">Kode promo: GLAMORA (diskon 15%)</p>
        </article>
        <article class="paket">
          <h3>Paket Busana Kelompok</h3>
          <p class="harga">Rp600.000<span> / hari</span></p>
          <p>Sewa 5 busana sekaligus untuk rombongan wisuda, keluarga, atau pagar ayu.</p>
          <p class="promo">Kode promo: GLAMORA (diskon 15%)</p>
        </article>
      </div>
    </section>

    <!-- BAGIAN 4: KALKULATOR (SE) -->
    <section id="calc-section" data-role="SE">
      <h2>Kalkulator sewa</h2>
      <p class="sub">Total = harga paket × jumlah hari − diskon kode promo.</p>
      <div class="kalkulator">
        <label for="paket">Pilih paket</label>
        <select id="paket">
          <option value="150000">Paket Busana Dasar - Rp150.000</option>
          <option value="300000">Paket Busana Beserta Rias Wajah - Rp300.000</option>
          <option value="600000">Paket Busana Kelompok - Rp600.000</option>
        </select>

        <label for="hari">Jumlah hari sewa</label>
        <input type="number" id="hari" min="1" value="1">

        <label for="promo">Kode promo (opsional)</label>
        <input type="text" id="promo" placeholder="Masukkan kode promo">

        <button type="button" class="btn" id="tombol-hitung">Hitung total</button>

        <div id="hasil" class="hasil" aria-live="polite"></div>
      </div>
    </section>
