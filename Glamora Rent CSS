/* =========================================================
   styles.css | Glamora Rent
   Tema: fashion premium (maroon, krem, pink dusty, hijau zaitun)
   Disesuaikan dengan index.html & script.js kelompok
   ========================================================= */

@import url("https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,500;0,6..96,700;1,6..96,500&family=Cinzel+Decorative:wght@700;900&family=Jost:wght@400;500;600&display=swap");

/* ---------- 1. SKEMA WARNA & TOKEN ---------- */
:root {
  --maroon: #4a1229;
  --maroon-dark: #340b1c;
  --cream: #f4ead9;
  --cream-soft: #fbf5ea;
  --pink: #c4728f;
  --olive: #b9bd6a;
  --ink: #2a0e18;

  --font-display: "Bodoni Moda", "Playfair Display", Georgia, serif;
  --font-brand: "Cinzel Decorative", "Cinzel", Georgia, serif;
  --font-body: "Jost", "Segoe UI", Arial, sans-serif;

  --radius-lg: 28px;
  --radius-md: 18px;
  --radius-sm: 10px;
  --shadow: 0 14px 34px rgba(74, 18, 41, 0.18);
}

/* ---------- 2. RESET & DASAR ---------- */
* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.65;
  color: var(--ink);
  background: var(--cream);
}

h1, h2, h3 {
  font-family: var(--font-display);
  letter-spacing: -0.02em;
}

:focus-visible {
  outline: 3px solid var(--pink);
  outline-offset: 3px;
}

/* ---------- HEADER ---------- */
#header-section {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.6rem 1rem;
  padding: 0.9rem clamp(1.25rem, 5vw, 3.5rem);
  background: rgba(244, 234, 217, 0.94);
  backdrop-filter: blur(8px);
  border-bottom: 2px solid var(--maroon);
}

.brand {
  font-family: var(--font-brand);
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0.03em;
  white-space: nowrap;
  color: var(--maroon);
  text-decoration: none;
}

#header-section nav {
  display: flex;
  gap: 0.4rem;
}

#header-section nav a {
  padding: 0.45rem 1.1rem;
  border-radius: 999px;
  font-weight: 500;
  text-decoration: none;
  color: var(--maroon);
  transition: background 0.2s, color 0.2s;
}

#header-section nav a:hover {
  background: var(--maroon);
  color: var(--cream);
}

/* ---------- 3. HERO ---------- */
#hero-section {
  position: relative;
  overflow: hidden;
  width: min(100% - 2.5rem, 1120px);
  margin: 1.25rem auto 0;
  padding: clamp(2.5rem, 7vw, 4.5rem) clamp(1.5rem, 5vw, 4rem) clamp(3rem, 8vw, 5.5rem);
  background: var(--maroon);
  color: var(--cream);
  border-radius: var(--radius-lg);
}

/* Huruf raksasa transparan di belakang, seperti inspirasi */
#hero-section::before {
  content: "WISUDA";
  position: absolute;
  right: -3%;
  bottom: -20%;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(6rem, 23vw, 18rem);
  line-height: 1;
  letter-spacing: -0.04em;
  color: rgba(244, 234, 217, 0.1);
  pointer-events: none;
  white-space: nowrap;
}

#hero-section > * {
  position: relative;
  max-width: 640px;
}

#hero-section h1 {
  margin: 0 0 1.3rem;
  font-size: clamp(1.6rem, 4vw, 2.6rem);
  font-weight: 700;
  line-height: 1.15;
  color: var(--cream);
}

.lead {
  margin: 0 0 1.6rem;
  max-width: 48ch;
  font-size: 1.1rem;
  color: rgba(244, 234, 217, 0.88);
}

/* Gambar busana di dalam hero (ukuran kecil) */
.busana-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.8rem;
  max-width: 440px;
  margin: 0 0 1.8rem;
}

.busana {
  margin: 0;
  overflow: hidden;
  background: var(--cream-soft);
  border: 1.5px solid rgba(244, 234, 217, 0.6);
  border-radius: var(--radius-sm);
}

.busana svg {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 5;
}

.busana figcaption {
  padding: 0.4rem 0.3rem;
  font-family: var(--font-display);
  font-size: 0.85rem;
  font-weight: 700;
  text-align: center;
  color: var(--maroon);
  border-top: 1.5px solid var(--maroon);
}

.keunggulan {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin: 0 0 2rem;
  padding: 0;
  list-style: none;
}

.keunggulan li {
  padding: 0.45rem 1rem;
  font-size: 0.95rem;
  border: 1.5px solid rgba(244, 234, 217, 0.55);
  border-radius: 999px;
}

/* ---------- 4. TOMBOL ---------- */
.btn {
  display: inline-block;
  padding: 0.85rem 1.9rem;
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: 600;
  text-decoration: none;
  color: var(--maroon);
  background: var(--pink);
  border: 2px solid var(--pink);
  border-radius: 999px;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
}

.btn:hover {
  background: var(--olive);
  border-color: var(--olive);
  transform: translateY(-2px);
}

.btn:active { transform: translateY(0); }

/* ---------- 5. KONTEN UTAMA ---------- */
main {
  width: min(100% - 2.5rem, 1120px);
  margin: 0 auto;
  padding: 0;
}

#catalog-section,
#calc-section {
  margin-top: clamp(3.5rem, 8vw, 6rem);
  padding: 0;
}

h2 {
  margin: 0 0 0.5rem;
  font-size: clamp(2rem, 5vw, 3.4rem);
  font-weight: 700;
  line-height: 1.05;
  color: var(--maroon);
}

.sub {
  margin: 0;
  color: rgba(42, 14, 24, 0.75);
}

/* ---------- 6. KATALOG ---------- */
.paket-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
  margin-top: 2.2rem;
}

.paket {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding: 1.8rem;
  background: var(--cream-soft);
  border: 2px solid var(--maroon);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
  transition: transform 0.25s, background 0.25s, color 0.25s;
}

.paket h3 {
  margin: 0;
  font-size: 1.6rem;
  line-height: 1.15;
  color: var(--maroon);
}

.paket p { margin: 0; }

.harga {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 500;
  font-size: 2rem;
  line-height: 1.2;
  color: var(--pink);
}

.harga span {
  font-family: var(--font-body);
  font-style: normal;
  font-size: 0.9rem;
  color: rgba(42, 14, 24, 0.65);
}

.paket:hover {
  transform: translateY(-6px);
  background: var(--maroon);
  color: var(--cream);
}

.paket:hover h3 { color: var(--cream); }
.paket:hover .harga span { color: rgba(244, 234, 217, 0.75); }

.promo {
  align-self: flex-start;
  margin-top: auto !important;
  padding: 0.3rem 0.9rem;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--maroon);
  background: var(--olive);
  border-radius: 999px;
}

/* Paket unggulan (tengah) jadi titik fokus */
.paket.unggulan {
  background: var(--maroon);
  color: var(--cream);
}

.paket.unggulan h3 { color: var(--cream); }
.paket.unggulan .harga span { color: rgba(244, 234, 217, 0.75); }

.paket.unggulan:hover {
  background: var(--pink);
  color: var(--maroon);
}

.paket.unggulan:hover h3 { color: var(--maroon); }
.paket.unggulan:hover .harga { color: var(--maroon); }
.paket.unggulan:hover .harga span { color: var(--maroon); }

/* ---------- 7. KALKULATOR ---------- */
#calc-section {
  padding: clamp(1.5rem, 5vw, 3.5rem);
  background: var(--pink);
  border-radius: var(--radius-lg);
}

#calc-section h2 { color: var(--maroon-dark); }
#calc-section .sub { color: var(--maroon-dark); }

.kalkulator {
  max-width: 560px;
  margin-top: 1.8rem;
  padding: clamp(1.25rem, 4vw, 2rem);
  background: var(--cream-soft);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow);
}

label {
  display: block;
  margin: 1.1rem 0 0.4rem;
  font-weight: 500;
  color: var(--maroon);
}

label:first-child { margin-top: 0; }

select,
input {
  width: 100%;
  padding: 0.8rem 1rem;
  font-family: var(--font-body);
  font-size: 1rem;
  color: var(--ink);
  background: #fff;
  border: 2px solid var(--maroon);
  border-radius: var(--radius-sm);
  transition: border-color 0.2s, box-shadow 0.2s;
}

select:focus,
input:focus {
  outline: none;
  border-color: var(--pink);
  box-shadow: 0 0 0 4px rgba(196, 114, 143, 0.3);
}

.kalkulator .btn {
  width: 100%;
  margin-top: 1.5rem;
  color: var(--cream);
  background: var(--maroon);
  border-color: var(--maroon);
}

.kalkulator .btn:hover {
  color: var(--maroon);
  background: var(--olive);
  border-color: var(--olive);
}

/* ---------- 8. HASIL PERHITUNGAN ---------- */
.hasil:not(:empty) {
  margin-top: 1.4rem;
  padding: 1.2rem 1.5rem;
  background: var(--maroon);
  color: var(--cream);
  border-radius: var(--radius-md);
}

.hasil table {
  width: 100%;
  border-collapse: collapse;
}

.hasil td {
  padding: 0.5rem 0;
  border-bottom: 1px dashed rgba(244, 234, 217, 0.35);
}

.hasil td:last-child {
  text-align: right;
  white-space: nowrap;
}

.hasil .diskon td:last-child { color: var(--pink); }

.hasil .total td {
  padding-top: 0.9rem;
  border-bottom: 0;
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--olive);
}

.pesan {
  margin: 0.8rem 0 0;
  font-size: 0.95rem;
}

.pesan.ok { color: var(--olive); }
.pesan.salah { color: #ffb4a8; }

/* ---------- 9. FOOTER ---------- */
#footer-section {
  margin-top: clamp(3.5rem, 8vw, 6rem);
  padding: 2rem 1.5rem;
  text-align: center;
  color: rgba(244, 234, 217, 0.88);
  background: var(--maroon);
}

footer p { margin: 0; }
footer .brand-foot {
  font-family: var(--font-display);
  font-size: 1.4rem;
  color: var(--cream);
}
footer p + p { margin-top: 0.4rem; font-size: 0.95rem; }

/* ---------- 10. RESPONSIF ---------- */
@media (max-width: 640px) {
  #header-section { flex-direction: column; gap: 0.5rem; }
  #header-section nav { flex-wrap: wrap; justify-content: center; }
  #hero-section { margin-top: 0.75rem; }
  .paket-grid { grid-template-columns: 1fr; }
  .busana-grid { gap: 0.5rem; }
  .busana figcaption { font-size: 0.75rem; }
  .hasil td { font-size: 0.95rem; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  * { transition: none !important; }
}
